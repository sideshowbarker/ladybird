{
    "manifest_version": 3,
    "name": "Idle Fixture",
    "version": "1.0",
    "description": "A manifest version 3 background page that unloads when idle.",
    "background": {
        "scripts": [
            "bg.js"
        ]
    },
    "content_scripts": [
        {
            "matches": [
                "file:///*/Extensions/idle-unload-wakes-on-message.html"
            ],
            "js": [
                "cs.js"
            ],
            "run_at": "document_end"
        }
    ]
}
