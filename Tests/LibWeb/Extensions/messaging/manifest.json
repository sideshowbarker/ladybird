{
    "manifest_version": 3,
    "name": "Messaging Fixture",
    "version": "1.0",
    "description": "A background page and a content script that exchange runtime messages.",
    "background": { "scripts": ["bg.js"] },
    "content_scripts": [
        { "matches": ["file:///*/Extensions/send-message-*.html", "file:///*/Extensions/background-to-content.html"], "js": ["cs.js"], "run_at": "document_end" }
    ]
}
