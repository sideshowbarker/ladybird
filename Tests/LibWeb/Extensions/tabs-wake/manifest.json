{
    "manifest_version": 3,
    "name": "Tabs Wake Fixture",
    "version": "1.0",
    "description": "An event page with a tabs.onUpdated listener, which a tab's change wakes.",
    "permissions": [
        "tabs"
    ],
    "background": {
        "scripts": [
            "bg.js"
        ]
    },
    "content_scripts": [
        {
            "matches": [
                "file:///*/Extensions/tabs-on-updated-wakes-listener.html"
            ],
            "js": [
                "cs.js"
            ],
            "run_at": "document_end"
        }
    ]
}
