{
    "manifest_version": 3,
    "name": "Session Storage Fixture",
    "version": "1.0",
    "description": "A background page that uses storage.session for the test page, and decides whether its content script may.",
    "permissions": [
        "storage"
    ],
    "background": {
        "scripts": [
            "bg.js"
        ]
    },
    "content_scripts": [
        {
            "matches": [
                "file:///*/Extensions/storage-session.html"
            ],
            "js": [
                "cs.js"
            ],
            "run_at": "document_end"
        }
    ]
}
