{
    "manifest_version": 3,
    "name": "Process Isolation Fixture",
    "version": "1.0",
    "description": "An extension page that opens a web page without an opener, for a test of the process the web page runs in.",
    "permissions": [
        "tabs"
    ],
    "background": {
        "scripts": [
            "bg.js"
        ]
    },
    "content_scripts": [
        {
            "matches": [
                "http://*/*Extensions/extension-process-isolation.html"
            ],
            "js": [
                "cs.js"
            ],
            "run_at": "document_end"
        },
        {
            "matches": [
                "http://*/echo/*/process-isolation-*"
            ],
            "js": [
                "web.js"
            ],
            "run_at": "document_idle"
        }
    ]
}
