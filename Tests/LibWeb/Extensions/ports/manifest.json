{
    "manifest_version": 3,
    "name": "Ports fixture",
    "version": "1.0",
    "background": {
        "scripts": [
            "bg.js"
        ]
    },
    "content_scripts": [
        {
            "matches": [
                "file:///*/Extensions/port-*.html"
            ],
            "js": [
                "cs.js"
            ],
            "run_at": "document_end"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "page.html",
                "page.js",
                "second.html",
                "second.js"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}
