{
    "manifest_version": 3,
    "name": "Companion Model Fixture",
    "version": "1.0",
    "description": "Uses the APIs the way Web Specs Companion does: a badge set from tabs.onUpdated, a popup that opens a tab and keeps itself open beside the page as a side panel, an alarm, and storage.session.",
    "permissions": [
        "tabs",
        "storage",
        "alarms",
        "sidePanel"
    ],
    "action": {
        "default_popup": "popup.html"
    },
    "background": {
        "scripts": [
            "bg.js"
        ]
    },
    "content_scripts": [
        {
            "matches": [
                "file:///*/Extensions/companion-model.html",
                "file:///*/Extensions/companion-model-side-panel.html"
            ],
            "js": [
                "cs.js"
            ],
            "run_at": "document_end"
        }
    ],
    "side_panel": {
        "default_path": "sidepanel.html"
    },
    "sidebar_action": {
        "default_panel": "sidepanel.html",
        "default_title": "Companion Model",
        "open_at_install": false
    }
}
