{
    "manifest_version": 3,
    "name": "Storage round-trip fixture",
    "version": "1.0",
    "permissions": [
        "storage"
    ],
    "content_scripts": [
        {
            "matches": [
                "file:///*/Extensions/storage-round-trip.html"
            ],
            "js": [
                "cs.js"
            ],
            "run_at": "document_end"
        }
    ]
}
