{
    "manifest_version": 3,
    "name": "Privileged Tabs Fixture",
    "version": "1.0",
    "description": "A background page that runs tabs.query() for the pages its content script is in, with the tabs permission.",
    "permissions": [
        "tabs"
    ],
    "background": {
        "scripts": [
            "bg.js"
        ]
    },
    "content_scripts": [
        {
            "matches": [
                "file:///*/Extensions/tabs-query-filters.html",
                "file:///*/Extensions/tabs-query-errors.html"
            ],
            "js": [
                "cs.js"
            ],
            "run_at": "document_end"
        }
    ]
}
